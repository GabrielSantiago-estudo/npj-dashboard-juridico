# Copie este arquivo para .env e ajuste se necessário.
# NUNCA comite o .env real.

APP_NAME=NPJ - Núcleo de Prática Jurídica
APP_ENV=development
APP_DEBUG=true

# Secret para sessão/cookies — gere uma nova com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=TROQUE_ESTA_CHAVE_POR_UMA_GERADA_LOCALMENTE

# Banco de dados (SQLite local no protótipo)
DATABASE_URL=sqlite:///./data/npj.db

# Caminhos de arquivos (relativos à raiz do projeto)
EXCEL_OPERACIONAL_PATH=./data/NPJ_Operacional.xlsx
EXCEL_HISTORICO_FICTICIO_PATH=./imports/NPJ_Historico_FICTICIO_2006_2025.xlsx
BACKUP_DIR=./data/backups
LOG_DIR=./logs

# Sessão
SESSION_MAX_AGE_SECONDS=28800

# Backup automático
BACKUP_AUTO_ENABLED=false
BACKUP_AUTO_INTERVAL_HOURS=24